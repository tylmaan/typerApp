/* typerApp – dark theme with a pitch-green accent.
   The same palette goes into the style guide of project 3. */

$pitch: #2bb673;
$pitch-dim: #1b6b45;
$joker: #f2c744;
$muted: #8b949e;

Screen {
    background: $surface;
    color: $text;
}

#brand {
    padding: 1 2 0 2;
    color: $pitch;
}

#player-bar {
    padding: 1 2;
    color: $text;
}

#hints {
    padding: 0 2 1 2;
    color: $muted;
}

/* ------------------------------------------------------------------ main menu */

#menu {
    margin: 0 2;
    background: $surface;
    border: round $pitch-dim;
    padding: 1 1;
    height: auto;
}

#menu > ListItem {
    padding: 0 1;
    background: $surface;
}

#menu > ListItem.-highlight {
    background: $pitch-dim;
    color: $text;
}

#menu:focus > ListItem.-highlight {
    background: $pitch;
    color: $surface;
    text-style: bold;
}

/* ------------------------------------------------------------- matchday screen */

#matchday-title {
    padding: 1 2 0 2;
}

#matchday-countdown {
    padding: 0 2 1 2;
    color: $joker;
}

#matches {
    margin: 0 2;
    border: round $pitch-dim;
    height: auto;
    max-height: 60%;
}

#matchday-summary {
    padding: 1 2 0 2;
    color: $muted;
}

MatchRow {
    height: 1;
    padding: 0 1;
}

MatchRow:focus {
    background: $boost;
}

MatchRow > .matchrow--time {
    color: $muted;
}

MatchRow > .matchrow--team {
    color: $text;
}

MatchRow > .matchrow--field {
    color: $text;
    background: $panel;
}

MatchRow > .matchrow--field-active {
    color: $surface;
    background: $pitch;
    text-style: bold;
}

MatchRow > .matchrow--joker {
    color: $joker;
    text-style: bold;
}

MatchRow > .matchrow--status {
    color: $pitch;
}

MatchRow > .matchrow--points {
    color: $joker;
    text-style: bold;
}

/* -------------------------------------------------------------------- dialogs */

PlayerPicker, NamePrompt {
    align: center middle;
}

#dialog {
    width: 46;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $pitch;
}

.dialog-title {
    padding-bottom: 1;
    text-style: bold;
}

.dialog-hint {
    padding-top: 1;
    color: $muted;
}

#player-list {
    height: auto;
    max-height: 10;
    background: $panel;
}

#player-list > ListItem {
    background: $panel;
}

#player-list > ListItem.-highlight {
    background: $pitch;
    color: $surface;
}

/* ------------------------------------------------------------ ranking screen */

#ranking-title {
    padding: 1 2;
}

#ranking {
    margin: 0 2;
    border: round $pitch-dim;
    height: auto;
    max-height: 70%;
}

RankingRow {
    height: 1;
    padding: 0 1;
}

RankingRow:focus {
    background: $boost;
}

RankingRow.-me {
    text-style: bold;
}

RankingRow > .rankingrow--position {
    color: $muted;
}

RankingRow > .rankingrow--name {
    color: $text;
}

RankingRow > .rankingrow--points {
    color: $pitch;
    text-style: bold;
}

RankingRow > .rankingrow--up {
    color: $pitch;
}

RankingRow > .rankingrow--down {
    color: #e06c6c;
}

RankingRow > .rankingrow--details {
    color: $muted;
}

/* ------------------------------------------------------------ profile screen */

#profile-name {
    padding: 1 2 0 2;
    color: $pitch;
}

#profile-headline {
    padding: 0 2;
    text-style: bold;
}

#profile-counters, #profile-extras {
    padding: 0 2;
    color: $muted;
}

#profile-matchdays {
    margin: 1 2;
    border: round $pitch-dim;
    height: auto;
    max-height: 50%;
}

#profile-matchdays > ListItem {
    padding: 0 1;
    background: $surface;
}

#profile-matchdays > ListItem.-highlight {
    background: $pitch-dim;
}

/* ----------------------------------------------------------- settings screen */

#settings-title {
    padding: 1 2 0 2;
}

#settings {
    margin: 1 2;
    border: round $pitch-dim;
    height: auto;
    max-height: 75%;
}

#settings > .section {
    padding: 1 1 0 1;
    color: $pitch;
    text-style: bold;
}

SettingRow {
    height: 1;
    padding: 0 1;
}

SettingRow:focus {
    background: $boost;
}

SettingRow > .settingrow--label {
    color: $text;
}

SettingRow > .settingrow--value {
    color: $text;
    background: $panel;
}

SettingRow > .settingrow--value-active {
    color: $surface;
    background: $pitch;
    text-style: bold;
}

SettingRow > .settingrow--hint {
    color: $muted;
}

#settings-players {
    height: auto;
    max-height: 8;
    background: $surface;
}

#settings-players > ListItem {
    padding: 0 1;
    background: $surface;
}

#settings-players > ListItem.-highlight {
    background: $pitch-dim;
}

/* ------------------------------------------------------------------- logo */

#logo {
    padding: 1 2 0 2;
    color: $pitch;
    text-style: bold;
}

#brand {
    padding: 0 2 0 2;
}

#matchday-countdown.-soon {
    color: $joker;
    text-style: bold;
}

#matchday-countdown.-urgent {
    color: #e06c6c;
    text-style: bold;
}

/* ---------------------------------------------------------------- demo mode */

/* A yellow line along the top of every screen, so it is never unclear whose data this is. */
TyperApp.-demo Screen {
    border-top: tall #f2c744;
}

/* ------------------------------------------------------------ match statuses */

MatchRow > .matchrow--state-scheduled {
    color: $muted;
}

MatchRow > .matchrow--state-live {
    color: $joker;
    text-style: bold;
}

MatchRow > .matchrow--state-finished {
    color: $pitch;
}

MatchRow > .matchrow--state-void {
    color: #e06c6c;
}

/* Predictions are closed: red, so it cannot be mistaken for the ticking countdown. */
#matchday-countdown.-closed {
    color: #e06c6c;
    text-style: bold;
}
